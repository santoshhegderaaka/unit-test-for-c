pipeline {
    agent any

    environment {
        CI = "true"
        NVM_DIR = "${env.HOME}/.nvm"
        BUILD_DIR = "build"
        BIN_NAME = "demo-app"
        DEPLOY_DIR = "/var/lib/jenkins/apps/demo-project-c"
        TEST_REPORT_DIR = "test-reports"
        NODE_VERSION = "22"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

   stage('Verify Build Tools') {
    steps {
        sh '''
          set -e
          command -v gcc
          command -v lcov
          command -v gcov
          gcc --version
          lcov --version
        '''
    }
}



        stage('Install nvm (if not exists)') {
            steps {
                sh '''
                  set -e

                  if [ ! -d "$NVM_DIR" ]; then
                    echo "Installing nvm..."
                    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
                  else
                    echo "nvm already installed"
                  fi

                  export NVM_DIR="$HOME/.nvm"
                  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

                  nvm --version
                '''
            }
        }
stage('Setup Node 22') {
  steps {
    sh '''
      export NVM_DIR="$HOME/.nvm"
      [ -s "$NVM_DIR/nvm.sh" ] || curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
      . "$NVM_DIR/nvm.sh"
      nvm install 22
      nvm use 22
      node -v
      npm -v
    '''
  }
}



        stage('Generate Unit Tests') {
            when {
                expression { fileExists('scripts/generate-c-tests.mjs') }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'GITHUB_TOKEN', variable: 'GITHUB_TOKEN')
                ]) {
                sh '''
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh"

  nvm install 22
  nvm use 22

  node -v
  npm -v


  chmod +x scripts/generate-c-tests.mjs
  node scripts/generate-c-tests.mjs --src src/task_manager.c
'''
                }
            }
        }

        stage('Prepare Build Directory') {
            steps {
                sh '''
                  rm -rf ${BUILD_DIR} ${TEST_REPORT_DIR}
                  mkdir -p ${BUILD_DIR} ${TEST_REPORT_DIR}
                '''
            }
        }

       stage('Compile & Run Unit Tests with Coverage') {
    steps {
        sh '''
          set -e
          echo "Running unit tests with coverage..."

          TEST_FILE="test/task_manager.test.c"
          TEST_NAME="task_manager"
          TEST_BIN="${BUILD_DIR}/${TEST_NAME}.test"
          COVERAGE_DIR="coverage"

          rm -rf ${COVERAGE_DIR}
          mkdir -p ${COVERAGE_DIR}

          echo "Compiling with coverage flags..."

          gcc -Wall -Wextra -I./src \
            --coverage \
            "$TEST_FILE" src/task_manager.c \
            -o "$TEST_BIN"

          echo "Executing test binary..."
          "$TEST_BIN"

          echo "Capturing coverage data..."

          lcov --capture \
               --directory . \
               --output-file ${COVERAGE_DIR}/coverage.info

          lcov --remove ${COVERAGE_DIR}/coverage.info \
               '/usr/*' \
               '*test*' \
               --output-file ${COVERAGE_DIR}/coverage.filtered.info

          genhtml ${COVERAGE_DIR}/coverage.filtered.info \
                  --output-directory ${COVERAGE_DIR}/html

          echo "Generating JUnit report..."

          cat > ${TEST_REPORT_DIR}/${TEST_NAME}.xml <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="task_manager_tests" tests="1" failures="0">
  <testcase classname="task_manager" name="AllTestsPassed"/>
</testsuite>
EOF
        '''
    }
}


        stage('Compile Application') {
            steps {
                sh '''
                  gcc -Wall -Wextra -I./src \
                    src/main.c src/queue.c src/task_manager.c \
                    -o ${BUILD_DIR}/${BIN_NAME}
                '''
            }
        }

      stage('Publish Coverage Report') {
    steps {
        publishHTML([
            reportName: 'C Coverage Report',
            reportDir: 'coverage/html',
            reportFiles: 'index.html',
            keepAll: true,
            alwaysLinkToLastBuild: true,
            allowMissing: false
        ])
    }
}


        stage('Deploy (Local)') {
            steps {
                sh '''
                  mkdir -p ${DEPLOY_DIR}

                  rsync -av --delete \
                    --exclude=.git \
                    --exclude=test \
                    --exclude=build \
                    ./ ${DEPLOY_DIR}/

                  cp ${BUILD_DIR}/${BIN_NAME} ${DEPLOY_DIR}/

                  pkill -f ${BIN_NAME} || true
                  nohup ${DEPLOY_DIR}/${BIN_NAME} > ${DEPLOY_DIR}/app.log 2>&1 &
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Build, Test, and Deploy completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
