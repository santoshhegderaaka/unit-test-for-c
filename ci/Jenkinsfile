pipeline {
    agent any

    environment {
        CI = "true"
        BUILD_DIR = "build"
        BIN_NAME = "demo-app"
        DEPLOY_DIR = "/var/lib/jenkins/apps/demo-project"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Build Tools') {
            steps {
                sh '''
                  set -e
                  echo "Installing GCC and build essentials..."

                  if ! command -v gcc >/dev/null 2>&1; then
                    sudo apt-get update
                    sudo apt-get install -y build-essential
                  fi

                  gcc --version
                '''
            }
        }

        stage('Prepare Build Directory') {
            steps {
                sh '''
                  rm -rf ${BUILD_DIR}
                  mkdir -p ${BUILD_DIR}
                '''
            }
        }

        stage('Compile Application') {
            steps {
                sh '''
                  echo "Compiling C application..."

                  gcc -Wall -Wextra -I./src \
                    src/*.c \
                    -o ${BUILD_DIR}/${BIN_NAME}

                  echo "Binary created: ${BUILD_DIR}/${BIN_NAME}"
                '''
            }
        }

        stage('Compile & Run Unit Tests') {
            when {
                expression { fileExists('test') }
            }
            steps {
                sh '''
                  echo "Compiling and running unit tests..."

                  for TEST_FILE in test/*.test.c; do
                    TEST_BIN="${BUILD_DIR}/$(basename ${TEST_FILE%.c})"

                    gcc -Wall -Wextra -I./src \
                      "$TEST_FILE" src/*.c \
                      -o "$TEST_BIN"

                    echo "Running $TEST_BIN"
                    "$TEST_BIN"
                  done

                  echo "All unit tests passed"
                '''
            }
        }

        stage('Deploy (Local)') {
            steps {
                sh '''
                  echo "Deploying C application locally..."

                  mkdir -p ${DEPLOY_DIR}

                  rsync -av --delete \
                    --exclude=.git \
                    --exclude=test \
                    --exclude=build \
                    ./ ${DEPLOY_DIR}/

                  cp ${BUILD_DIR}/${BIN_NAME} ${DEPLOY_DIR}/

                  echo "Stopping existing process (if any)..."
                  pkill -f ${BIN_NAME} || true

                  echo "Starting application..."
                  nohup ${DEPLOY_DIR}/${BIN_NAME} > ${DEPLOY_DIR}/app.log 2>&1 &

                  echo "Application deployed and started successfully"
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline completed"
        }
        failure {
            echo "Pipeline failed"
        }
    }
}
