pipeline {
    agent any

    environment {
        CI = "true"
        NVM_DIR = "${env.HOME}/.nvm"
        BUILD_DIR = "build"
        BIN_NAME = "demo-app"
        DEPLOY_DIR = "/var/lib/jenkins/apps/demo-project-c"
        TEST_REPORT_DIR = "test-reports"
        NODE_VERSION = "22"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Build Tools') {
            steps {
                sh '''
                  set -e
                  if ! command -v gcc >/dev/null 2>&1; then
                    sudo apt-get update
                    sudo apt-get install -y build-essential
                  fi
                  gcc --version
                '''
            }
        }
        stage('Install nvm (if not exists)') {
            steps {
                sh '''
                  set -e

                  if [ ! -d "$NVM_DIR" ]; then
                    echo "Installing nvm..."
                    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
                  else
                    echo "nvm already installed"
                  fi

                  export NVM_DIR="$HOME/.nvm"
                  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

                  nvm --version
                '''
            }
        }
stage('Setup Node 22') {
  steps {
    sh '''
      export NVM_DIR="$HOME/.nvm"
      [ -s "$NVM_DIR/nvm.sh" ] || curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
      . "$NVM_DIR/nvm.sh"
      nvm install 22
      nvm use 22
      node -v
      npm -v
    '''
  }
}



        stage('Generate Unit Tests') {
            when {
                expression { fileExists('scripts/generate-spec-tests.sh') }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'github-copilot-token', variable: 'COPILOT_TOKEN'),
                    string(credentialsId: 'github-push-token', variable: 'PUSH_TOKEN')
                ]) {
                sh '''
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh"

  nvm install 22
  nvm use 22

  node -v
  npm -v
export COPILOT_MODEL=GPT-5 mini
export CI=true

  chmod +x scripts/generate-spec-tests.sh
  node src/generate-c-tests.mjs --src src/task_manager.c --token $COPILOT_TOKEN
'''
                }
            }
        }

        stage('Prepare Build Directory') {
            steps {
                sh '''
                  rm -rf ${BUILD_DIR} ${TEST_REPORT_DIR}
                  mkdir -p ${BUILD_DIR} ${TEST_REPORT_DIR}
                '''
            }
        }

        stage('Compile & Run Unit Tests') {
            steps {
                sh '''
                  set -e
                  echo "Running unit tests..."

                  for TEST_FILE in test/*.test.c; do
                    TEST_NAME=$(basename ${TEST_FILE%.c})
                    TEST_BIN="${BUILD_DIR}/${TEST_NAME}"

                    gcc -Wall -Wextra -I./src \
                      "$TEST_FILE" src/queue.c src/task_manager.c \
                      -o "$TEST_BIN"

                    echo "Executing $TEST_BIN"
                    "$TEST_BIN"

                    cat > ${TEST_REPORT_DIR}/${TEST_NAME}.xml <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="${TEST_NAME}" tests="1" failures="0">
  <testcase classname="${TEST_NAME}" name="AllTestsPassed"/>
</testsuite>
EOF
                  done
                '''
            }
        }

        stage('Compile Application') {
            steps {
                sh '''
                  gcc -Wall -Wextra -I./src \
                    src/main.c src/queue.c src/task_manager.c \
                    -o ${BUILD_DIR}/${BIN_NAME}
                '''
            }
        }

        stage('Publish Test Results') {
            steps {
                junit allowEmptyResults: false, testResults: 'test-reports/*.xml'
            }
        }

        stage('Deploy (Local)') {
            steps {
                sh '''
                  mkdir -p ${DEPLOY_DIR}

                  rsync -av --delete \
                    --exclude=.git \
                    --exclude=test \
                    --exclude=build \
                    ./ ${DEPLOY_DIR}/

                  cp ${BUILD_DIR}/${BIN_NAME} ${DEPLOY_DIR}/

                  pkill -f ${BIN_NAME} || true
                  nohup ${DEPLOY_DIR}/${BIN_NAME} > ${DEPLOY_DIR}/app.log 2>&1 &
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Build, Test, and Deploy completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
