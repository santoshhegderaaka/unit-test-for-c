pipeline {
    agent any

    environment {
        CI = "true"
        NVM_DIR = "${env.HOME}/.nvm"
        BUILD_DIR = "build"
        BIN_NAME = "demo-app"
        DEPLOY_DIR = "/var/lib/jenkins/apps/demo-project-c"
        TEST_REPORT_DIR = "test-reports"
        NODE_VERSION = "22"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Build Tools') {
            steps {
                sh '''
                  set -e
                  command -v gcc
                  command -v lcov
                  command -v gcov
                  gcc --version
                  lcov --version
                '''
            }
        }

        stage('Install nvm (if not exists)') {
            steps {
                sh '''
                  set -e
                  if [ ! -d "$NVM_DIR" ]; then
                    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
                  fi
                  export NVM_DIR="$HOME/.nvm"
                  . "$NVM_DIR/nvm.sh"
                  nvm --version
                '''
            }
        }

        stage('Setup Node 22') {
            steps {
                sh '''
                  export NVM_DIR="$HOME/.nvm"
                  . "$NVM_DIR/nvm.sh"
                  nvm install 22
                  nvm use 22
                  node -v
                  npm -v
                '''
            }
        }

        stage('Generate Unit Tests') {
            when {
                expression { fileExists('scripts/generate-c-tests.mjs') }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'GITHUB_TOKEN', variable: 'GITHUB_TOKEN')
                ]) {
                    sh '''
                      export NVM_DIR="$HOME/.nvm"
                      . "$NVM_DIR/nvm.sh"
                      nvm use 22

                      chmod +x scripts/generate-c-tests.mjs
                      node scripts/generate-c-tests.mjs --src src/task_manager.c
                    '''
                }
            }
        }

        stage('Prepare Build Directory') {
            steps {
                sh '''
                  rm -rf ${BUILD_DIR} ${TEST_REPORT_DIR}
                  mkdir -p ${BUILD_DIR} ${TEST_REPORT_DIR}
                '''
            }
        }

stage('Compile & Run Unit Tests with Coverage') {
    steps {
        sh '''
          set -e
          echo "Running unit tests with coverage..."

          echo "📂 Contents of test directory:"
          ls -l test

          TEST_FILE=$(ls test/*.test.c 2>/dev/null | head -n 1)

          if [ -z "$TEST_FILE" ]; then
            echo "❌ No generated .test.c file found"
            exit 1
          fi

          echo "✅ Using test file: $TEST_FILE"

          TEST_NAME=$(basename "$TEST_FILE" .c)
          TEST_BIN="${BUILD_DIR}/${TEST_NAME}"
          COVERAGE_DIR="coverage"

          rm -rf "$COVERAGE_DIR"
          mkdir -p "$COVERAGE_DIR"

          echo "🔧 Compiling with coverage flags..."
          gcc -Wall -Wextra -I./src \
            --coverage \
            "$TEST_FILE" src/task_manager.c \
            -o "$TEST_BIN"

          echo "▶ Running tests..."
          "$TEST_BIN"

          echo "📊 Collecting coverage..."
          lcov --capture \
            --directory . \
            --output-file "$COVERAGE_DIR/coverage.info"

          echo "🧹 Cleaning coverage report..."
          lcov --remove "$COVERAGE_DIR/coverage.info" \
            '/usr/*' \
            '*/test/*' \
            --ignore-errors unused \
            --output-file "$COVERAGE_DIR/coverage.cleaned.info"

          genhtml "$COVERAGE_DIR/coverage.cleaned.info" \
            --output-directory "$COVERAGE_DIR/html"

          echo "✅ Coverage report generated at $COVERAGE_DIR/html/index.html"
        '''
    }
}


        stage('Compile Application') {
            steps {
                sh '''
                  gcc -Wall -Wextra -I./src \
                    src/main.c src/queue.c src/task_manager.c \
                    -o ${BUILD_DIR}/${BIN_NAME}
                '''
            }
        }

        stage('Publish Coverage Report') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'coverage/html',
                    reportFiles: 'index.html',
                    reportName: 'C Coverage Report'
                ])
            }
        }

        stage('Deploy (Local)') {
            steps {
                sh '''
                  mkdir -p ${DEPLOY_DIR}
                  rsync -av --delete \
                    --exclude=.git \
                    --exclude=test \
                    --exclude=build \
                    ./ ${DEPLOY_DIR}/

                  cp ${BUILD_DIR}/${BIN_NAME} ${DEPLOY_DIR}/
                  pkill -f ${BIN_NAME} || true
                  nohup ${DEPLOY_DIR}/${BIN_NAME} > ${DEPLOY_DIR}/app.log 2>&1 &
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Build, Test, Coverage, and Deploy completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
